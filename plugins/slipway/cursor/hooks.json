{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./cursor/hooks/session-start.sh", "timeout": 10 }
    ],
    "beforeShellExecution": [
      { "command": "./cursor/hooks/shell.sh", "timeout": 30, "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "./cursor/hooks/mcp.sh", "timeout": 15, "failClosed": true }
    ],
    "beforeReadFile": [
      { "command": "./cursor/hooks/read.sh", "timeout": 10, "failClosed": true }
    ],
    "preToolUse": [
      { "command": "./cursor/hooks/write.sh", "matcher": "Write|Edit|StrReplace|MultiEdit|edit_file|search_replace|write_file", "timeout": 20, "failClosed": true }
    ]
  }
}
