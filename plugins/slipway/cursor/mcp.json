{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/x/actions",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start",
        "--namespace",
        "acr",
        "--namespace",
        "containerapps",
        "--namespace",
        "keyvault",
        "--namespace",
        "group",
        "--namespace",
        "role",
        "--namespace",
        "subscription",
        "--namespace",
        "monitor",
        "--read-only"
      ]
    }
  }
}
