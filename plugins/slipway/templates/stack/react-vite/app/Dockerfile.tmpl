# syntax=docker/dockerfile:1
# <% project.name %>/<% app.name %> — generated by slipway (stack react-vite, base image Docker Hardened Images).
# Build:  docker build --build-arg VERSION=<semver> --build-arg COMMIT=<sha> -t <% app.image_local %>:<semver> <% app.path %>
# Runtime: nginx (distroless, user nginx uid 65532) serving the static build on <% app.port %><%#if app.upstream_list%> and proxying <%#each app.upstream_list%><% path_prefix %> to <% url_cloud %><%/each%> (Container Apps resolves the app name through the environment proxy)<%/if%>.
ARG NODE_VERSION=<% app.build.node_version %>
ARG NGINX_VERSION=<% app.build.nginx_version %>

FROM dhi.io/node:${NODE_VERSION}-dev AS build
ARG VERSION=0.0.0-local
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV VITE_APP_VERSION=${VERSION}
RUN npm run build

FROM dhi.io/nginx:${NGINX_VERSION} AS runtime
ARG VERSION=0.0.0-local
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="<% project.name %>/<% app.name %>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"<%#if github%> \
      org.opencontainers.image.source="https://github.com/<% github.owner %>/<% github.repo %>"<%/if%>
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/<% app.build.dist_dir %> /usr/share/nginx/html
EXPOSE <% app.port %>
# the base image already runs as user nginx (uid 65532) and owns /run/nginx, /var/cache/nginx and /var/log/nginx
