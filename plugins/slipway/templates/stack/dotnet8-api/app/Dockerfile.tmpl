# syntax=docker/dockerfile:1
# <% project.name %>/<% app.name %> — generated by slipway (stack dotnet8-api, base image Docker Hardened Images).
# Build (from the repository root): docker build --build-arg VERSION=<semver> --build-arg COMMIT=<sha> -t <% app.image_local %>:<semver> -f <% app.build.dockerfile %> <% app.build.context %>
<%#if app.build.context_root%># The build context is the repository root because this app builds inputs outside its own path (<%#each app.extra_paths%><% this %><%#if @last%><%else%>, <%/if%><%/each%>).
# Ignore rules come from Dockerfile.dockerignore next to this file (BuildKit prefers it over the context's .dockerignore).
<%/if%># Runtime image: distroless (no shell, no package manager), runs as uid 65532, listens on <% app.port %>.
ARG DOTNET_VERSION=<% app.build.dotnet_version %>

FROM dhi.io/dotnet:${DOTNET_VERSION}-sdk AS build
ARG VERSION=0.0.0-local
WORKDIR /src
# restore first so dependency layers are cached independently of source changes
COPY <% app.build.project_dir_from_context %>/*.csproj <% app.build.project_dir_from_context %>/
<%#each app.build.dep_project_dirs%>COPY <% this %>/*.csproj <% this %>/
<%/each%>RUN dotnet restore <% app.build.project_from_context %>
<%#each app.build.copy_dirs%>COPY <% this %> <% this %>
<%/each%>RUN dotnet publish <% app.build.project_from_context %> -c Release -o /out --no-restore \
      -p:Version=${VERSION} -p:InformationalVersion=${VERSION} -p:UseAppHost=false

FROM dhi.io/aspnetcore:${DOTNET_VERSION} AS runtime
ARG VERSION=0.0.0-local
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="<% project.name %>/<% app.name %>" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"<%#if github%> \
      org.opencontainers.image.source="https://github.com/<% github.owner %>/<% github.repo %>"<%/if%>
WORKDIR /app
COPY --from=build --chown=65532:65532 /out ./
ENV ASPNETCORE_HTTP_PORTS=<% app.port %> \
    DOTNET_EnableDiagnostics=0
EXPOSE <% app.port %>
USER 65532
ENTRYPOINT ["dotnet", "<% app.build.assembly %>.dll"]
