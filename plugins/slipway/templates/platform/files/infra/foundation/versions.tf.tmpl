# Generated by slipway (platform foundation for <% name %>/<% environment %>). Regenerate with platform.cjs; do not hand-edit.
terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
  }

  # State lives in the storage account created by setup-platform.sh (shared-key access disabled): Entra ID auth only.
  backend "azurerm" {
    resource_group_name  = "<% azure.state.resource_group %>"
    storage_account_name = "<% azure.state.storage_account %>"
    container_name       = "<% azure.state.container %>"
    key                  = "<% name %>/platform/<% environment %>.tfstate"
    use_azuread_auth     = true
  }
}

provider "azurerm" {
  features {
    key_vault {
      purge_soft_delete_on_destroy = false
    }
  }
  storage_use_azuread             = true
  resource_provider_registrations = "none" # providers are registered once by an owner; the CI/CD identity never needs that right
}
