#!/usr/bin/env bash
# One-time Azure prerequisites of the slipway platform `<% name %>` (<% environment %>) — HUMAN-ONLY, idempotent.
# Generated by platform.cjs from platform.yaml (re-render to refresh).
#
#   bash setup-platform.sh                               # preflight + dry run: prints what would change, changes nothing
#   bash setup-platform.sh --apply                       # create what is missing
#   bash setup-platform.sh --apply --set-github-secrets  # also set the AZURE_* organisation secrets with gh
#   bash setup-platform.sh --grant-per-app-roles         # (a subscription Owner, after the foundation apply) the two
#                                                        #  conditioned role-assignment grants per-app identities need
#
# What it creates: the resource groups, the Terraform state storage (Entra-only auth), the CI/CD user-assigned managed
# identity with four FLEXIBLE federated credentials that match every repository of the GitHub organisation (no client
# secret), and least-privilege role assignments. Registry, key vault, logs and the Container Apps environment belong to
# infra/foundation (Terraform). It never prints or stores a secret.
set -euo pipefail

APPLY=false; SET_SECRETS=false; GRANT=false
for a in "$@"; do case "$a" in --apply) APPLY=true;; --set-github-secrets) SET_SECRETS=true;; --grant-per-app-roles) GRANT=true; APPLY=true;; -h|--help) sed -n '2,16p' "$0"; exit 0;; *) echo "unknown arg: $a" >&2; exit 2;; esac; done

# ---- names from platform.yaml ----
PLATFORM="<% name %>"; ENVIRONMENT="<% environment %>"; LOCATION="<% location %>"
RG="<% azure.resource_group %>"
STATE_RG="<% azure.state.resource_group %>"; STATE_SA="<% azure.state.storage_account %>"; STATE_CONTAINER="<% azure.state.container %>"
UAMI="<% azure.cicd_identity_name %>"
ACR="<% azure.registry.name %>"; ACR_RG="<%#if azure.registry.existing%><%#if azure.registry.resource_group%><% azure.registry.resource_group %><%else%><% azure.resource_group %><%/if%><%else%><% azure.resource_group %><%/if%>"
KV="<% azure.key_vault_name %>"
GH_ORG="<% github.org %>"; GH_ORG_ID="<% github.org_id %>"; GH_BRANCH="<% github.default_branch %>"
ISSUER="https://token.actions.githubusercontent.com"; AUDIENCE="api://AzureADTokenExchange"
FIC_API="2025-01-31-preview" # flexible federated identity credentials on user-assigned managed identities (preview)
ROLE_ACRPULL="7f951dda-4ed3-4680-a7ca-43fe172d538d"; ROLE_KV_SECRETS_USER="4633458b-17de-408a-b874-0445c86b69e6"

say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  ok    %s\n' "$*"; }
todo() { printf '  %s %s\n' "$($APPLY && echo 'apply' || echo 'would ')" "$*"; }
run()  { if $APPLY; then "$@"; else printf '        $ %s\n' "$*"; fi; }

# ---- preflight ----
say "Preflight"
command -v az >/dev/null || { echo "az CLI not installed" >&2; exit 1; }
SUB_ID=$(az account show --query id -o tsv 2>/dev/null) || { echo "not logged in: az login && az account set --subscription <name>" >&2; exit 1; }
TENANT_ID=$(az account show --query tenantId -o tsv); SUB_NAME=$(az account show --query name -o tsv)
ok "subscription: $SUB_NAME"
ME_ID=$(az ad signed-in-user show --query id -o tsv); ME_UPN=$(az ad signed-in-user show --query userPrincipalName -o tsv); ok "user: $ME_UPN"
SUB_ROLES=$(az role assignment list --assignee "$ME_ID" --all --include-inherited --query "[?scope=='/subscriptions/$SUB_ID' || scope=='/'].roleDefinitionName" -o tsv | sort -u | tr '\n' ',')
echo "$SUB_ROLES" | grep -Eq 'Owner|Contributor' && ok "can create resource groups and identities (roles: $SUB_ROLES)" || { echo "  FAIL  need Contributor or Owner on the subscription" >&2; PRE_FAIL=1; }
echo "$SUB_ROLES" | grep -Eq 'Owner|User Access Administrator' && ok "can assign roles at subscription scope" || echo "  WARN  no Owner/User Access Administrator on the subscription; the role assignments below need them on the target scopes" >&2
if $GRANT && ! echo "$SUB_ROLES" | grep -q 'Owner'; then echo "  WARN  --grant-per-app-roles needs a subscription Owner (a conditioned User Access Administrator usually cannot grant RBAC Administrator); the commands are printed for the Owner" >&2; fi
if [ "$GH_ORG_ID" = "" ] || [ "$GH_ORG_ID" = "123456789" ]; then echo "  FAIL  github.org_id in platform.yaml must be the organisation's numeric id: gh api orgs/$GH_ORG --jq .id" >&2; PRE_FAIL=1; fi
[ "${PRE_FAIL:-0}" = 0 ] || { echo "preflight failed; nothing changed" >&2; exit 1; }
$APPLY || say "Dry run (add --apply to execute). Commands that would run:"

# ---- 1. resource groups ----
say "1. Resource groups"
az group show -n "$STATE_RG" >/dev/null 2>&1 && ok "resource group $STATE_RG" || { todo "create resource group $STATE_RG"; run az group create -n "$STATE_RG" -l "$LOCATION" -o none; }
az group show -n "$RG" >/dev/null 2>&1 && ok "resource group $RG" || { todo "create resource group $RG"; run az group create -n "$RG" -l "$LOCATION" -o none; }
RG_SCOPE="/subscriptions/$SUB_ID/resourceGroups/$RG"

# ---- 2. terraform state storage (Entra-only auth) ----
say "2. Terraform state: $STATE_RG / $STATE_SA / $STATE_CONTAINER"
if az storage account show -n "$STATE_SA" -g "$STATE_RG" >/dev/null 2>&1; then ok "storage account $STATE_SA"
else todo "create storage account $STATE_SA (shared key disabled)"; run az storage account create -n "$STATE_SA" -g "$STATE_RG" -l "$LOCATION" --sku Standard_LRS --kind StorageV2 --min-tls-version TLS1_2 --allow-blob-public-access false --allow-shared-key-access false -o none; fi
SA_SCOPE="/subscriptions/$SUB_ID/resourceGroups/$STATE_RG/providers/Microsoft.Storage/storageAccounts/$STATE_SA"
CONTAINER_SCOPE="$SA_SCOPE/blobServices/default/containers/$STATE_CONTAINER"

# ---- 3. CI/CD identity ----
say "3. CI/CD identity $UAMI (user-assigned managed identity)"
if az identity show -n "$UAMI" -g "$RG" >/dev/null 2>&1; then ok "exists"; else todo "create identity $UAMI"; run az identity create -n "$UAMI" -g "$RG" -l "$LOCATION" -o none; fi
UAMI_PID=$(az identity show -n "$UAMI" -g "$RG" --query principalId -o tsv 2>/dev/null || true)
UAMI_CLIENT_ID=$(az identity show -n "$UAMI" -g "$RG" --query clientId -o tsv 2>/dev/null || true)
UAMI_RES="$RG_SCOPE/providers/Microsoft.ManagedIdentity/userAssignedIdentities/$UAMI"

# ---- 4. flexible federated credentials: one expression covers every repository of the organisation ----
say "4. Federated credentials (issuer $ISSUER, audience $AUDIENCE, api-version $FIC_API)"
# GitHub sends either the classic subject  repo:<org>/<repo>:...  or, with immutable subject claims, repo:<org>@<org-id>/<repo>@<repo-id>:...
# A flexible credential matches `sub` with wildcards and must also pin an immutable claim: repository_owner_id = the organisation id.
fic() { # name expression
  local name="$1" expr="$2" url body
  url="https://management.azure.com${UAMI_RES}/federatedIdentityCredentials/${name}?api-version=${FIC_API}"
  body="$(mktemp)"; python3 - "$expr" "$ISSUER" "$AUDIENCE" > "$body" <<'PY'
import json, sys
print(json.dumps({"properties": {"issuer": sys.argv[2], "audiences": [sys.argv[3]], "claimsMatchingExpression": {"value": sys.argv[1], "languageVersion": 1}}}))
PY
  local current; current="$(az rest --method GET --url "$url" --query "properties.claimsMatchingExpression.value" -o tsv 2>/dev/null || true)"
  if [ "$current" = "$expr" ]; then ok "$name: $expr"; else todo "${current:+update}${current:-add} $name: $expr"; run az rest --method PUT --url "$url" --body "@$body" -o none; fi
  rm -f "$body"
}
OWNER_CLAIM="claims['repository_owner_id'] eq '${GH_ORG_ID}'"
fic "github-ci-immutable"  "claims['sub'] matches 'repo:${GH_ORG}@${GH_ORG_ID}/*:ref:refs/heads/${GH_BRANCH}' and ${OWNER_CLAIM}"
fic "github-cd-immutable"  "claims['sub'] matches 'repo:${GH_ORG}@${GH_ORG_ID}/*:environment:${ENVIRONMENT}' and ${OWNER_CLAIM}"
fic "github-ci-classic"    "claims['sub'] matches 'repo:${GH_ORG}/*:ref:refs/heads/${GH_BRANCH}' and ${OWNER_CLAIM}"
fic "github-cd-classic"    "claims['sub'] matches 'repo:${GH_ORG}/*:environment:${ENVIRONMENT}' and ${OWNER_CLAIM}"

# ---- 5. role assignments (least privilege) ----
say "5. Role assignments"
has_role() { [ -n "$1" ] && [ "$(az role assignment list --assignee "$1" --scope "$3" --include-inherited --query "[?roleDefinitionName=='$2'] | length(@)" -o tsv 2>/dev/null || echo 0)" != "0" ]; }
assign() { # principal-object-id principal-type role scope label
  local pid="$1" ptype="$2" role="$3" scope="$4" label="$5"
  if has_role "$pid" "$role" "$scope"; then ok "$label: $role (held or inherited)"; return 0; fi
  todo "$label: $role on ${scope#/subscriptions/$SUB_ID/}"
  run az role assignment create --assignee-object-id "${pid:-<identity-principal-id>}" --assignee-principal-type "$ptype" --role "$role" --scope "$scope" -o none
}
assign "$ME_ID"             User             "Storage Blob Data Contributor" "$SA_SCOPE"        "you"
assign "${UAMI_PID:-}"      ServicePrincipal "Contributor"                   "$RG_SCOPE"        "cicd identity"
assign "${UAMI_PID:-}"      ServicePrincipal "Storage Blob Data Contributor" "$CONTAINER_SCOPE" "cicd identity"
if az storage container show -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login >/dev/null 2>&1; then ok "container $STATE_CONTAINER"
elif $APPLY; then todo "create container $STATE_CONTAINER (RBAC propagation can take ~1 min; retrying)"; for i in 1 2 3 4 5 6; do az storage container create -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login -o none 2>/dev/null && break || sleep 15; done
else todo "create container $STATE_CONTAINER"; run az storage container create -n "$STATE_CONTAINER" --account-name "$STATE_SA" --auth-mode login -o none; fi

# ---- 6. conditioned grants for per-app identities (Owner) ----
# Repositories on the shared platform create one identity per app and assign it AcrPull on the registry and Key Vault
# Secrets User on its own secrets. The CI/CD identity therefore needs to create role assignments, but only those two roles:
# Azure ABAC conditions on the delegating roles restrict what it may assign (and remove).
COND_ACR="((!(ActionMatches{'Microsoft.Authorization/roleAssignments/write'})) OR (@Request[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {${ROLE_ACRPULL}})) AND ((!(ActionMatches{'Microsoft.Authorization/roleAssignments/delete'})) OR (@Resource[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {${ROLE_ACRPULL}}))"
COND_KV="((!(ActionMatches{'Microsoft.Authorization/roleAssignments/write'})) OR (@Request[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {${ROLE_KV_SECRETS_USER}})) AND ((!(ActionMatches{'Microsoft.Authorization/roleAssignments/delete'})) OR (@Resource[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {${ROLE_KV_SECRETS_USER}}))"
ACR_SCOPE="/subscriptions/$SUB_ID/resourceGroups/$ACR_RG/providers/Microsoft.ContainerRegistry/registries/$ACR"
KV_SCOPE="$RG_SCOPE/providers/Microsoft.KeyVault/vaults/$KV"
if $GRANT; then
  say "6. Conditioned role-assignment grants for per-app identities (needs the registry and the vault: apply infra/foundation first)"
  az acr show -n "$ACR" -g "$ACR_RG" >/dev/null 2>&1 || { echo "  FAIL  registry $ACR not found in $ACR_RG; apply infra/foundation first" >&2; exit 1; }
  az keyvault show -n "$KV" -g "$RG" >/dev/null 2>&1 || { echo "  FAIL  key vault $KV not found in $RG; apply infra/foundation first" >&2; exit 1; }
  if has_role "$UAMI_PID" "Role Based Access Control Administrator" "$ACR_SCOPE"; then ok "cicd identity: RBAC Administrator on the registry (AcrPull only)"
  else todo "cicd identity: Role Based Access Control Administrator on the registry, condition: AcrPull only"; run az role assignment create --assignee-object-id "$UAMI_PID" --assignee-principal-type ServicePrincipal --role "Role Based Access Control Administrator" --scope "$ACR_SCOPE" --condition "$COND_ACR" --condition-version "2.0" -o none; fi
  if has_role "$UAMI_PID" "Key Vault Data Access Administrator" "$KV_SCOPE"; then ok "cicd identity: Key Vault Data Access Administrator on the vault (Secrets User only)"
  else todo "cicd identity: Key Vault Data Access Administrator on the vault, condition: Key Vault Secrets User only"; run az role assignment create --assignee-object-id "$UAMI_PID" --assignee-principal-type ServicePrincipal --role "Key Vault Data Access Administrator" --scope "$KV_SCOPE" --condition "$COND_KV" --condition-version "2.0" -o none; fi
else
  say "6. Conditioned grants for per-app identities: run later as a subscription Owner, after infra/foundation is applied"
  printf '  bash setup-platform.sh --grant-per-app-roles\n'
fi

# ---- 7. outputs ----
say "7. Values for GitHub (identifiers, not secrets; stored as organisation secrets so they stay out of public logs)"
printf '  AZURE_CLIENT_ID=%s  (the CI/CD identity)\n  AZURE_TENANT_ID and AZURE_SUBSCRIPTION_ID: from az account show\n' "${UAMI_CLIENT_ID:-<after --apply>}"
if $SET_SECRETS && $APPLY; then
  command -v gh >/dev/null || { echo "gh not installed; set the organisation secrets manually" >&2; exit 1; }
  printf '%s' "$UAMI_CLIENT_ID" | gh secret set AZURE_CLIENT_ID       --org "$GH_ORG" --visibility all
  printf '%s' "$TENANT_ID"      | gh secret set AZURE_TENANT_ID       --org "$GH_ORG" --visibility all
  printf '%s' "$SUB_ID"         | gh secret set AZURE_SUBSCRIPTION_ID --org "$GH_ORG" --visibility all
  ok "organisation secrets set on $GH_ORG (visibility: all repositories; private repositories need a paid GitHub plan to read them)"
else
  printf '  Then: re-run with --apply --set-github-secrets, or set the three organisation secrets yourself (gh secret set <NAME> --org %s --visibility all)\n' "$GH_ORG"
fi
say "Done$($APPLY || echo ' (dry run)'). Next: terraform -chdir=infra/foundation init && plan -out=tfplan.$ENVIRONMENT, read it, apply it; then --grant-per-app-roles (Owner); then publish org-defaults.yaml as ONBOARD_ANSWERS_TEMPLATE."
