# Values rendered from .slipway/config.yaml for app `<% app.name %>`. Change them with /slipway:bootstrap, then re-scaffold.
locals {
  project     = "<% project.name %>"
  environment = "<% derived.env %>"
  app         = "<% app.name %>"

  resource_group_name = "<% azure.resource_group %>"
  acr_name            = "<% azure.acr_name %>"
  key_vault_name      = "<% azure.key_vault_name %>"
<%#eq options.identity_scope "shared"%>  identity_name       = "<% azure.identity_name %>"
<%else%>  app_identity_name   = "<% app.identity_name_app %>" # one identity per app (options.identity_scope: per-app)
<%/eq%>  cae_name            = "<% derived.cae_name %>"
  container_app_name  = "<% app.container_app_name %>"<%#if derived.platform_shared%> # namespaced by project: the environment is shared by several repositories<%/if%>

  tags = {
    project     = local.project
    environment = local.environment
    managed_by  = "terraform"
    layer       = "app"
    generator   = "slipway"
  }
}
<%#eq options.registry_scope "existing"%>
# Shared registry (options.registry_scope: existing): looked up in its own resource group.
locals {
  acr_resource_group_name = "<% derived.acr_resource_group %>"
}
<%/eq%>