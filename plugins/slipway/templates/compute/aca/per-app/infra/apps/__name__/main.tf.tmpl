# App layer for `<% app.name %>`: one container app in the shared environment (<%#if derived.platform_shared%>the organisation platform<%else%>infra/foundation<%/if%>).<%#if app.has_ingress%> Other apps
# reach it as http://<% app.container_app_name %> through the environment proxy<%#if derived.platform_shared%> (names are prefixed by the project because the environment is
# shared by several repositories)<%/if%>.<%else%> A worker: no ingress, nothing
# reaches it; it reaches the other apps as http://<%#if derived.platform_shared%><% project.name %>-<app><%else%><app><%/if%> through the environment proxy.<%/if%>

resource "azurerm_container_app" "this" {
  name                         = local.container_app_name
  container_app_environment_id = data.azurerm_container_app_environment.this.id
  resource_group_name          = data.azurerm_resource_group.env.name
  revision_mode                = "Single"
  tags                         = local.tags

  identity {
    type         = "UserAssigned"
    identity_ids = [local.app_identity_id]
  }

  registry {
    server   = data.azurerm_container_registry.this.login_server
    identity = local.app_identity_id
  }
<%#each app.secrets%>
  secret {
    name                = "<% name %>"
    identity            = local.app_identity_id
    key_vault_secret_id = "${data.azurerm_key_vault.this.vault_uri}secrets/<% kv_name %>"
  }
<%/each%><%#eq options.identity_scope "per-app"%>
  # the identity must hold its roles before the app pulls its image and resolves its secret references
  depends_on = [azurerm_role_assignment.app_acr_pull, azurerm_role_assignment.app_kv_secret]
<%/eq%><%#if app.has_ingress%>
  ingress {
    external_enabled           = <% app.external %>
    target_port                = <% app.port %>
    transport                  = "auto"
    allow_insecure_connections = false

    traffic_weight {
      latest_revision = true
      percentage      = 100
    }
  }
<%/if%>
  template {
    min_replicas = <% app.min_replicas %>
    max_replicas = <% app.max_replicas %>

    container {
      name   = "<% app.name %>"
      image  = "${data.azurerm_container_registry.this.login_server}/<% app.image_repository %>:${var.image_tag}"
      cpu    = <% app.cpu %>
      memory = "<% app.memory %>"

      env {
        name  = "APP_VERSION"
        value = var.image_tag
      }
<%#each app.env_list%>
      env {
        name  = "<% name %>"
        value = "<% value %>"
      }
<%/each%><%#each app.secrets%>
      env {
        name        = "<% env %>"
        secret_name = "<% name %>"
      }
<%/each%><%#if app.health_path%>
      # First start may take a while (cold start, image pull, a slow dependency): the startup probe allows up to ~150 s
      # before liveness takes over, so a slow first revision is not restarted in a loop.
      startup_probe {
        transport               = "HTTP"
        port                    = <% app.port %>
        path                    = "<% app.health_path %>"
        interval_seconds        = 5
        timeout                 = 5
        failure_count_threshold = 30
      }

      liveness_probe {
        transport               = "HTTP"
        port                    = <% app.port %>
        path                    = "<% app.health_path %>"
        interval_seconds        = 10
        failure_count_threshold = 3
      }

      readiness_probe {
        transport               = "HTTP"
        port                    = <% app.port %>
        path                    = "<% app.health_path %>"
        interval_seconds        = 5
        failure_count_threshold = 3
        success_count_threshold = 1
      }
<%/if%>    }
  }
}
