# Generated by slipway for app `<% app.name %>` (runner=github-actions, cd_trigger=<% options.cd_trigger %>). Regenerate with the scaffold; do not hand-edit.
# CD of ONE app: deploy one immutable tag of `<% app.name %>` to one environment through the stages in _cd.yml (plan, human approval, apply, smoke).
<%#if derived.pipelines.auto_cd%># Starts automatically when <% app.workflow_ci %> succeeds on <% github.default_branch %> (target: <% github.cd_environment %>; the tag is read from
# that run's release manifest, since workflow_run cannot carry inputs) and on demand with `/slipway:deploy <% app.name %> <tag> <env>`.
<%else%># Started on demand with `/slipway:deploy <% app.name %> <tag> <env>` (workflow_dispatch).
<%/if%>name: <% app.workflow_cd %>

on:
  workflow_dispatch:
    inputs:
      tag:
        description: Immutable image tag of <% app.name %> from <% app.workflow_ci %> (semver, e.g. <% app.initial_version %>.3)
        required: true
        type: string
      environment:
        description: Target environment
        required: true
        default: <% github.cd_environment %>
        type: choice
        options:
<%#each environments%>          - <% this %>
<%/each%><%#if derived.pipelines.auto_cd%>  workflow_run:
    workflows: ["<% app.workflow_ci %>"]
    types: [completed]
    branches: [<% github.default_branch %>]
<%/if%>
concurrency:
  group: <% app.workflow_cd %>-${{ inputs.environment || '<% github.cd_environment %>' }}
  cancel-in-progress: false

permissions:
  id-token: write
  contents: read
  actions: read   # read the release manifest artifact of the CI run

jobs:
  resolve:
    name: <% app.name %> resolve
    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    outputs:
      tag: ${{ steps.r.outputs.tag }}
      environment: ${{ steps.r.outputs.environment }}
    steps:
<%#if derived.pipelines.auto_cd%>      - name: Read the release manifest of the CI run that completed
        if: github.event_name == 'workflow_run'
        uses: actions/download-artifact@v7
        with:
          pattern: release-manifest-<% app.name %>-*
          merge-multiple: true
          path: manifest
          run-id: ${{ github.event.workflow_run.id }}
          github-token: ${{ github.token }}
<%/if%>      - id: r
        run: |
          if [ "${{ github.event_name }}" = "workflow_run" ]; then
            [ -f manifest/release-manifest.json ] || { echo "::error::CI run ${{ github.event.workflow_run.id }} published no release manifest for <% app.name %> (no release job on that run); nothing to deploy"; exit 1; }
            TAG=$(python3 -c 'import json; print(json.load(open("manifest/release-manifest.json"))["version"])')
            ENV="<% github.cd_environment %>"
          else
            TAG="${{ inputs.tag }}"; ENV="${{ inputs.environment }}"
          fi
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"; echo "environment=$ENV" >> "$GITHUB_OUTPUT"
          echo "### <% app.name %> $TAG → $ENV (${{ github.event_name }})" >> "$GITHUB_STEP_SUMMARY"

  cd:
    name: <% app.name %>
    needs: resolve
    uses: ./.github/workflows/_cd.yml
    with:
      app: <% app.name %>
      tag: ${{ needs.resolve.outputs.tag }}
      environment: ${{ needs.resolve.outputs.environment }}
      infra_dir: <% app.infra_dir %>
      image_repository: <% app.image_repository %>
    secrets: inherit
