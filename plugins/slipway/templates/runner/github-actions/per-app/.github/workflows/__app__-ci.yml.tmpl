# Generated by slipway for app `<% app.name %>` (runner=github-actions, pr_checks=<% options.pr_checks %>). Regenerate with the scaffold; do not hand-edit.
# CI of ONE app. It runs when this app's inputs change (the `paths` below are rendered from .slipway/config.yaml and are the
# same list as the pathFilters in <% app.version_file %>). The stages live in _ci.yml. Deployment: <% app.workflow_cd %>.yml.
name: <% app.workflow_ci %>

on:
  pull_request:
    branches: [<% github.default_branch %>]
<%#eq options.pr_checks "path-filtered"%>    paths:
<%#each app.trigger_paths%>      - "<% this %>"
<%/each%><%/eq%>  push:
    branches: [<% github.default_branch %>]
    paths:
<%#each app.trigger_paths%>      - "<% this %>"
<%/each%>  workflow_dispatch:

concurrency:
  group: <% app.workflow_ci %>-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: write   # the release job creates the tag <% app.tag_prefix %><version> on <% github.default_branch %>
  id-token: write   # OIDC token for azure/login (no stored cloud credentials)
  pull-requests: read

jobs:
<%#eq options.pr_checks "always-run-gate"%>  changes:
    # Always runs on pull requests so the checks below can be required on <% github.default_branch %>: when the PR does not touch
    # this app's inputs, `ci` is skipped, and a conditionally skipped job counts as passed for required status checks.
    # Job names carry the app name so the check names stay unique across apps (`<% app.name %> changes`, `<% app.name %> / test`).
    name: <% app.name %> changes
    runs-on: ubuntu-latest
    outputs:
      run: ${{ steps.gate.outputs.run }}
    steps:
      - id: gate
        env:
          GH_TOKEN: ${{ github.token }}
          APP_PATHS: |
<%#each app.pipeline_paths%>            <% this %>
<%/each%>        run: |
          if [ "${{ github.event_name }}" != "pull_request" ]; then echo "run=true" >> "$GITHUB_OUTPUT"; exit 0; fi
          gh api "repos/${{ github.repository }}/pulls/${{ github.event.pull_request.number }}/files" --paginate --jq '.[].filename' > changed.txt
          python3 - <<'PY'
          import os
          paths=[p.strip().rstrip("/") for p in os.environ["APP_PATHS"].splitlines() if p.strip()]
          changed=[l.strip() for l in open("changed.txt") if l.strip()]
          hit=[f for f in changed if any(f==p or f.startswith(p+"/") for p in paths)]
          with open(os.environ["GITHUB_OUTPUT"],"a") as out: out.write(f"run={'true' if hit else 'false'}\n")
          with open(os.environ["GITHUB_STEP_SUMMARY"],"a") as s:
              s.write(f"### <% app.name %>: {'changed' if hit else 'untouched'} by this pull request ({len(changed)} changed files, {len(hit)} among this app's inputs)\n")
              for f in hit[:20]: s.write(f"- `{f}`\n")
          PY

  ci:
    name: <% app.name %>
    needs: changes
    if: needs.changes.outputs.run == 'true'
<%else%>  ci:
    name: <% app.name %>
<%/eq%>    uses: ./.github/workflows/_ci.yml
    with:
      app: <% app.name %>
      app_path: <% app.path %>
      context: <% app.build.context %>
      dockerfile: <% app.build.dockerfile %>
      image_repository: <% app.image_repository %>
<%#if app.test_command%>      test_command: "<% app.test_command %>"
<%/if%>      is_dotnet: <% app.is_dotnet %>
      is_node: <% app.is_node %>
      tag_prefix: <% app.tag_prefix %>
    secrets: inherit

  result:
    # Always produces a check named `<% app.name %> ci`, whether the app was built or skipped: reusable-workflow jobs emit
    # no nested checks when the caller job is skipped, so a branch rule must require this check (and `<% app.name %> changes`).
    name: <% app.name %> ci
    needs: [<%#eq options.pr_checks "always-run-gate"%>changes, <%/eq%>ci]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - run: |
          echo "ci job result: ${{ needs.ci.result }}"
          case "${{ needs.ci.result }}" in
            success) echo "<% app.name %>: built and tested";;
            skipped) echo "<% app.name %>: untouched by this change, nothing to build";;
            *) echo "::error::<% app.name %>: CI ${{ needs.ci.result }}"; exit 1;;
          esac
