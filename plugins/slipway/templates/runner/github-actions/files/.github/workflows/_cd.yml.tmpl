# Generated by slipway (runner=github-actions, compute=<% options.compute %>). Regenerate with the scaffold; do not hand-edit.
# Shared CD stages for ONE app, called by <% derived.pipelines.name_prefix %>-<app>-cd.yml: deploy ONE immutable image tag of ONE app
# to ONE environment. `plan` runs first and publishes the plan for review; `apply` runs only after the GitHub environment
# approval and applies exactly that plan, then smoke-tests the app.
name: _cd

on:
  workflow_call:
    inputs:
      app:
        type: string
        required: true
      tag:
        description: Immutable image tag from the app's CI (semver)
        type: string
        required: true
      environment:
        type: string
        required: true
      infra_dir:
        description: Terraform root module of this app (infra/apps/<app>)
        type: string
        required: true
      image_repository:
        type: string
        required: true

env:
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  ARM_USE_OIDC: "true"
  ARM_USE_AZUREAD: "true"
  ARM_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
  ARM_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
  ARM_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
  IMAGE_TAG: ${{ inputs.tag }}

jobs:
  plan:
    name: plan ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Validate the tag
        run: |
          case "$IMAGE_TAG" in
            latest|main|master|dev|develop|staging|prod|production) echo "::error::'$IMAGE_TAG' is a mutable tag; deploy a semver tag from CI"; exit 1;;
          esac
          echo "$IMAGE_TAG" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+' || { echo "::error::'$IMAGE_TAG' is not a semver tag"; exit 1; }
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
<%#eq options.registry "acr"%>      - name: The image must exist for this tag
        run: |
          d=$(az acr repository show -n <% azure.acr_name %> --image "${{ inputs.image_repository }}:$IMAGE_TAG" --query digest -o tsv 2>/dev/null || true)
          [ -n "$d" ] || { echo "::error::${{ inputs.image_repository }}:$IMAGE_TAG not found in <% azure.acr_name %>"; exit 1; }
          echo "  ${{ inputs.app }}: $d"
<%/eq%>      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - name: terraform init / validate / plan
        working-directory: ${{ inputs.infra_dir }}
        run: |
          terraform init -input=false
          terraform validate -no-color
          terraform plan -input=false -no-color -var "image_tag=$IMAGE_TAG" -out=tfplan | tee plan.txt
          {
            echo "## Plan for ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}"
            echo '```'; grep -E '^(Plan:|No changes)' plan.txt || tail -5 plan.txt; echo '```'
            echo '<details><summary>Full plan</summary>'; echo; echo '```'; cat plan.txt; echo '```'; echo '</details>'
          } >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v7
        with:
          name: tfplan-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: |
            ${{ inputs.infra_dir }}/tfplan
            ${{ inputs.infra_dir }}/plan.txt
          retention-days: 1

  apply:
    name: apply ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}
    needs: plan
    runs-on: ubuntu-latest
    environment:
      name: ${{ inputs.environment }}   # required reviewer approves here, after reading the plan summary
      url: ${{ steps.outputs.outputs.url }}
    steps:
      - uses: actions/checkout@v7
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - uses: actions/download-artifact@v7
        with:
          name: tfplan-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: ${{ inputs.infra_dir }}
      - name: terraform apply (the reviewed plan, nothing else)
        working-directory: ${{ inputs.infra_dir }}
        run: |
          terraform init -input=false
          terraform apply -input=false -no-color tfplan | tee apply.txt
          echo "## Applied ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}" >> "$GITHUB_STEP_SUMMARY"
          grep -E '^Apply complete' apply.txt >> "$GITHUB_STEP_SUMMARY" || true
      - name: Collect outputs
        id: outputs
        working-directory: ${{ inputs.infra_dir }}
        run: |
          terraform output -json > outputs.json
          python3 - <<'PY'
          import json
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}
          print("\n".join(f"{k}={v}" for k,v in o.items()))
          with open("$GITHUB_OUTPUT","a") as f: f.write(f"url={o.get('url','')}\n")
          PY
      - name: Smoke test
        working-directory: ${{ inputs.infra_dir }}
        run: |
          set -e; fail=0
          python3 - <<'PY' > smoke.txt || fail=1
          import json,urllib.request,time,sys
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}; tag=o["image_tag"]; app="${{ inputs.app }}"
          url=o.get("health_url")
          if not url: print(f"SKIPPED  {app}: no ingress, nothing to probe"); sys.exit(0)
          # The apply returns before the new revision takes traffic (Single revision mode switches once its probes pass,
          # typically 20-60 s later), so the previous revision may still answer 200 with the old version. Wait for version == tag.
          start=time.time(); deadline=start+240; last="no response"
          while True:
              try:
                  with urllib.request.urlopen(url, timeout=20) as r:
                      body=r.read().decode("utf-8","replace"); code=r.status
              except Exception as e:
                  code=None; body=str(e)
              if code==200 and not body.lstrip().startswith("{"):
                  print(f"CONFIRMED {app}: {url} -> 200 (no version in the body) after {int(time.time()-start)}s"); sys.exit(0)
              if code==200:
                  v=json.loads(body).get("version")
                  if v==tag: print(f"CONFIRMED {app}: {url} -> 200 version={v} (tag {tag}) after {int(time.time()-start)}s"); sys.exit(0)
                  last=f"200 version={v} (previous revision still serving)"
              else:
                  last=f"{code} {body[:120]}"
              if time.time()>deadline: print(f"REFUTED  {app}: {url} -> {last}; expected version {tag} within 240s"); sys.exit(1)
              time.sleep(10)
          PY
          cat smoke.txt; { echo "### Smoke test"; echo '```'; cat smoke.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
          exit $fail
      - uses: actions/upload-artifact@v7
        if: always()
        with:
          name: deploy-evidence-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}
          path: |
            ${{ inputs.infra_dir }}/outputs.json
            ${{ inputs.infra_dir }}/apply.txt
            ${{ inputs.infra_dir }}/smoke.txt
          retention-days: 90
