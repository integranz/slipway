# Generated by slipway (runner=github-actions, compute=<% options.compute %>). Regenerate with the scaffold; do not hand-edit.
# Shared CD stages for ONE app, called by <% derived.pipelines.name_prefix %>-<app>-cd.yml: deploy ONE immutable image tag of ONE app
# to ONE environment. `plan` runs first and publishes the plan for review; `apply` runs only after the GitHub environment
# approval and applies exactly that plan, then smoke-tests the app.
name: _cd

on:
  workflow_call:
    inputs:
      app:
        type: string
        required: true
      tag:
        description: Immutable image tag from the app's CI (semver)
        type: string
        required: true
      environment:
        type: string
        required: true
      infra_dir:
        description: Terraform root module of this app (infra/apps/<app>)
        type: string
        required: true
      image_repository:
        type: string
        required: true
      tag_prefix:
        description: Git tag prefix of this app (<app>/v); the GitHub Release <prefix><tag> receives the deploy evidence
        type: string
        required: false
        default: ""
      kv_secrets:
        description: Key Vault secret names the revision references (comma-separated); checked before the plan so a missing one fails here, not at provisioning
        type: string
        required: false
        default: ""

env:
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  ARM_USE_OIDC: "true"
  ARM_USE_AZUREAD: "true"
  ARM_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
  ARM_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
  ARM_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
  IMAGE_TAG: ${{ inputs.tag }}

jobs:
  plan:
    name: plan ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}
    runs-on: ubuntu-latest
    defaults:
      run:
        shell: bash   # GitHub's explicit bash runs with -e and -o pipefail, so a failed terraform behind `| tee` fails the step
    steps:
      - uses: actions/checkout@v7
      - name: Validate the tag
        run: |
          case "$IMAGE_TAG" in
            latest|main|master|dev|develop|staging|prod|production) echo "::error::'$IMAGE_TAG' is a mutable tag; deploy a semver tag from CI"; exit 1;;
          esac
          echo "$IMAGE_TAG" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+' || { echo "::error::'$IMAGE_TAG' is not a semver tag"; exit 1; }
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - name: Key Vault secrets the revision references must exist
        if: inputs.kv_secrets != ''
        env:
          KV_SECRETS: ${{ inputs.kv_secrets }}
        run: |
          # Container Apps refuses to provision a revision whose Key Vault reference cannot be resolved, and that would only
          # surface after the approval. Each name is read through ARM (metadata only, never a value); 404 means missing.
          base="https://management.azure.com/subscriptions/$ARM_SUBSCRIPTION_ID/resourceGroups/<% azure.resource_group %>/providers/Microsoft.KeyVault/vaults/<% azure.key_vault_name %>/secrets"
          missing=0
          for s in ${KV_SECRETS//,/ }; do
            if az rest --method GET --url "$base/$s?api-version=2023-07-01" -o none 2>kv-err.txt; then echo "  ok: $s"
            elif grep -Eq 'NotFound|404' kv-err.txt; then
              echo "::error::Key Vault secret '$s' does not exist in <% azure.key_vault_name %>. Set it as .slipway/SETUP.md describes, or in your terminal with the value typed at a silent prompt: read -rs V && az keyvault secret set --vault-name <% azure.key_vault_name %> --name $s --value \"\$V\" -o none; unset V"; missing=1
            else
              echo "::error::could not read the metadata of Key Vault secret '$s' through ARM: $(head -c 300 kv-err.txt). The CI/CD identity needs Microsoft.KeyVault/vaults/secrets/read on the vault (Reader or Contributor on its resource group)."; missing=1
            fi
          done
          rm -f kv-err.txt; exit $missing
<%#eq options.registry "acr"%>      - name: The image must exist for this tag
        run: |
          d=$(az acr repository show -n <% azure.acr_name %> --image "${{ inputs.image_repository }}:$IMAGE_TAG" --query digest -o tsv 2>/dev/null || true)
          [ -n "$d" ] || { echo "::error::${{ inputs.image_repository }}:$IMAGE_TAG not found in <% azure.acr_name %>"; exit 1; }
          echo "  ${{ inputs.app }}: $d"
<%/eq%>      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - name: terraform init / validate / plan
        working-directory: ${{ inputs.infra_dir }}
        run: |
          terraform init -input=false
          terraform validate -no-color
          terraform plan -input=false -no-color -var "image_tag=$IMAGE_TAG" -out=tfplan | tee plan.txt
          {
            echo "## Plan for ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}"
            echo '```'; grep -E '^(Plan:|No changes)' plan.txt || tail -5 plan.txt; echo '```'
            echo '<details><summary>Full plan</summary>'; echo; echo '```'; cat plan.txt; echo '```'; echo '</details>'
          } >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v7
        with:
          name: tfplan-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: |
            ${{ inputs.infra_dir }}/tfplan
            ${{ inputs.infra_dir }}/plan.txt
            ${{ inputs.infra_dir }}/.terraform.lock.hcl
          include-hidden-files: true   # upload-artifact skips dot-files by default; the lock file must travel with the plan
          retention-days: 1
<%#if derived.tracker_rest%>      - name: Tracker — deploy subtask In Progress (Jira REST)
        if: always()
        uses: actions/checkout@v7
        with:
          repository: <% derived.marketplace.repo %>
          ref: v<% derived.plugin_version %>
          path: .slipway-plugin
      - name: Tracker — subtask start
        if: always()
        env:
          JIRA_EMAIL: ${{ vars.JIRA_EMAIL }}
          JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
        run: |
          J="node .slipway-plugin/plugins/slipway/scripts/jira-rest.cjs --repo . --soft"
          $J subtask start "Deploy ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}" --message "Plan ${{ job.status }}: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }} (waits for the ${{ inputs.environment }} approval)"
<%/if%>
  apply:
    name: apply ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}
    needs: plan
    runs-on: ubuntu-latest
    defaults:
      run:
        shell: bash   # -e -o pipefail: a failed apply behind `| tee` fails the job
    environment:
      name: ${{ inputs.environment }}   # required reviewer approves here, after reading the plan summary
      url: ${{ steps.outputs.outputs.url }}
    steps:
      - uses: actions/checkout@v7
      - name: Azure login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false
      - uses: actions/download-artifact@v7
        with:
          name: tfplan-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}-${{ github.run_id }}
          path: ${{ inputs.infra_dir }}
      - name: terraform apply (the reviewed plan, nothing else)
        working-directory: ${{ inputs.infra_dir }}
        run: |
          # the lock file arrived with the plan: the apply uses exactly the provider versions the plan was made with
          terraform init -input=false -lockfile=readonly
          terraform apply -input=false -no-color tfplan | tee apply.txt
          echo "## Applied ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}" >> "$GITHUB_STEP_SUMMARY"
          grep -E '^Apply complete' apply.txt >> "$GITHUB_STEP_SUMMARY" || true
      - name: Collect outputs
        id: outputs
        working-directory: ${{ inputs.infra_dir }}
        run: |
          terraform output -json > outputs.json
          python3 - <<'PY'
          import json, os
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}
          print("\n".join(f"{k}={v}" for k,v in o.items()))
          with open(os.environ["GITHUB_OUTPUT"], "a") as f: f.write(f"url={o.get('url','')}\n")
          PY
      - name: Smoke test
        id: smoke
        working-directory: ${{ inputs.infra_dir }}
        run: |
          set -e; fail=0
          python3 - <<'PY' > smoke.txt || fail=1
          import json,urllib.request,time,sys
          o={k:v["value"] for k,v in json.load(open("outputs.json")).items()}; tag=o["image_tag"]; app="${{ inputs.app }}"
          url=o.get("health_url")
          if not url: print(f"SKIPPED  {app}: no ingress, nothing to probe"); sys.exit(0)
          # The apply returns before the new revision takes traffic (Single revision mode switches once its probes pass,
          # typically 20-60 s later), so the previous revision may still answer 200 with the old version. Wait for version == tag.
          start=time.time(); deadline=start+240; last="no response"
          while True:
              try:
                  with urllib.request.urlopen(url, timeout=20) as r:
                      body=r.read().decode("utf-8","replace"); code=r.status
              except Exception as e:
                  code=None; body=str(e)
              if code==200 and not body.lstrip().startswith("{"):
                  print(f"CONFIRMED {app}: {url} -> 200 (no version in the body) after {int(time.time()-start)}s"); sys.exit(0)
              if code==200:
                  v=json.loads(body).get("version")
                  if v==tag: print(f"CONFIRMED {app}: {url} -> 200 version={v} (tag {tag}) after {int(time.time()-start)}s"); sys.exit(0)
                  last=f"200 version={v} (previous revision still serving)"
              else:
                  last=f"{code} {body[:120]}"
              if time.time()>deadline: print(f"REFUTED  {app}: {url} -> {last}; expected version {tag} within 240s"); sys.exit(1)
              time.sleep(10)
          PY
          cat smoke.txt; { echo "### Smoke test"; echo '```'; cat smoke.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
          exit $fail
<%#eq options.evidence_store "release"%>      - name: Attach deploy evidence to the GitHub Release ${{ inputs.tag_prefix }}${{ inputs.tag }}
        if: always()
        working-directory: ${{ inputs.infra_dir }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          TAG="${{ inputs.tag_prefix }}${{ inputs.tag }}"; ENV="${{ inputs.environment }}"
          for f in outputs.json apply.txt smoke.txt; do [ -f "$f" ] && cp "$f" "deploy-$ENV-$f"; done
          gh release upload "$TAG" deploy-"$ENV"-* --clobber \
            || echo "::warning::GitHub Release $TAG not found or not writable; the deploy evidence stays in the workflow artifact only"
<%/eq%><%#if derived.tracker_rest%>      - name: Tracker — deploy subtask Done or In Review (Jira REST)
        if: always()
        uses: actions/checkout@v7
        with:
          repository: <% derived.marketplace.repo %>
          ref: v<% derived.plugin_version %>
          path: .slipway-plugin
      - name: Tracker — subtask done or review
        if: always()
        env:
          JIRA_EMAIL: ${{ vars.JIRA_EMAIL }}
          JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
          SMOKE: ${{ steps.smoke.outcome }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          J="node .slipway-plugin/plugins/slipway/scripts/jira-rest.cjs --repo . --soft"
          T="Deploy ${{ inputs.app }} ${{ inputs.tag }} → ${{ inputs.environment }}"
          if [ "$SMOKE" = "success" ]; then $J subtask done "$T" --message "Applied and smoke-tested: $RUN_URL"<%#eq options.evidence_store "release"%> --evidence "${{ github.server_url }}/${{ github.repository }}/releases/tag/${{ inputs.tag_prefix }}${{ inputs.tag }}"<%/eq%>
          else $J subtask review "$T" --message "Apply or smoke test did not succeed (smoke: $SMOKE): $RUN_URL"; fi
<%/if%>      - uses: actions/upload-artifact@v7
        if: always()
        with:
          name: deploy-evidence-${{ inputs.app }}-${{ inputs.environment }}-${{ inputs.tag }}
          path: |
            ${{ inputs.infra_dir }}/outputs.json
            ${{ inputs.infra_dir }}/apply.txt
            ${{ inputs.infra_dir }}/smoke.txt
          retention-days: 90
