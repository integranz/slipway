# Generated by slipway (runner=github-actions, versioning=<% options.versioning %>). Regenerate with the scaffold; do not hand-edit.
# Shared CI stages for ONE app, called by <% derived.pipelines.name_prefix %>-<app>-ci.yml after that app's tests passed there: compute the app's version, build
# the image with the version stamped in, push the immutable tag on <% github.default_branch %>, tag the commit and publish a
# release manifest. Deployment is the app's CD workflow (<% derived.pipelines.name_prefix %>-<app>-cd.yml).
name: _ci

on:
  workflow_call:
    inputs:
      app:
        description: App name from .slipway/config.yaml
        type: string
        required: true
      app_path:
        description: Directory of the app (holds version.json and the Dockerfile)
        type: string
        required: true
      context:
        description: Docker build context (the app path, or . when the app has inputs outside its path)
        type: string
        required: true
      dockerfile:
        description: Dockerfile path relative to the repository root
        type: string
        required: true
      image_repository:
        description: Image repository inside the registry
        type: string
        required: true
      is_dotnet:
        type: boolean
        required: false
        default: false
      is_node:
        type: boolean
        required: false
        default: false
      tag_prefix:
        description: Git tag prefix of this app's releases (for example api/v)
        type: string
        required: true
    outputs:
      version:
        description: The version built by this run
        value: ${{ jobs.version.outputs.version }}

env:
  REGISTRY: <% derived.registry_host %>
  IS_RELEASE: ${{ github.event_name != 'pull_request' && github.ref == 'refs/heads/<% github.default_branch %>' }}

jobs:
  version:
    name: version
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.v.outputs.version }}
      commit: ${{ steps.v.outputs.commit }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0   # full history: the version depends on it
<%#eq options.versioning "nbgv"%>      - uses: actions/setup-dotnet@v6
        with:
          dotnet-version: 8.0.x
      - name: Compute the version of ${{ inputs.app }} with Nerdbank.GitVersioning
        id: nbgv
        uses: dotnet/nbgv@v0.5.2
        with:
          path: ${{ inputs.app_path }}   # <app path>/version.json: its own version, height counted over its pathFilters only
      - id: v
        run: |
          echo "version=${{ steps.nbgv.outputs.SemVer2 }}" >> "$GITHUB_OUTPUT"
          echo "commit=${{ steps.nbgv.outputs.GitCommitIdShort }}" >> "$GITHUB_OUTPUT"
          echo "### ${{ inputs.app }} ${{ steps.nbgv.outputs.SemVer2 }} (public release: ${{ steps.nbgv.outputs.PublicRelease }})" >> "$GITHUB_STEP_SUMMARY"
<%/eq%><%#eq options.versioning "semantic-release"%>      - uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Compute next version with semantic-release (dry run)
        id: sr
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          npm ci --no-audit --no-fund
          # semantic-release prints "The next release version is X.Y.Z" in dry-run mode; on non-release branches or with no
          # releasable commits there is no version and the image is tagged with the commit only.
          NEXT=$(npx semantic-release --dry-run --no-ci 2>&1 | sed -nE 's/.*The next release version is ([0-9]+\.[0-9]+\.[0-9]+[^ ]*).*/\1/p' | tail -1)
          echo "next=${NEXT}" >> "$GITHUB_OUTPUT"
      - id: v
        run: |
          SHORT=$(git rev-parse --short HEAD)
          echo "version=${{ steps.sr.outputs.next || format('0.0.0-sha.{0}', github.sha) }}" >> "$GITHUB_OUTPUT"
          echo "commit=$SHORT" >> "$GITHUB_OUTPUT"
<%/eq%>
  image:
    name: image
    needs: [version]   # tests run in the calling workflow (per app, with that app's service containers) before this workflow starts
    runs-on: ubuntu-latest
    outputs:
      digest: ${{ steps.build.outputs.digest }}
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4
<%#eq options.base_image "dhi"%>      - name: Log in to Docker Hardened Images
        uses: docker/login-action@v4
        with:
          registry: dhi.io
          username: ${{ vars.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
<%/eq%><%#eq options.cloud "azure"%>      - name: Azure login (OIDC)
        if: env.IS_RELEASE == 'true'
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
<%/eq%><%#eq options.registry "acr"%>      - name: Log in to the container registry
        if: env.IS_RELEASE == 'true'
        run: az acr login --name <% azure.acr_name %>
      - name: Refuse to overwrite an existing tag (tags are immutable)
        if: env.IS_RELEASE == 'true'
        run: |
          if [ -n "$(az acr repository show -n <% azure.acr_name %> --image "${{ inputs.image_repository }}:${{ needs.version.outputs.version }}" --query digest -o tsv 2>/dev/null)" ]; then
            echo "::error::${{ inputs.image_repository }}:${{ needs.version.outputs.version }} already exists in <% azure.acr_name %>. Tags are immutable: bump the version (new commit) instead of re-running a release build."
            exit 1
          fi
<%/eq%>      - name: Build${{ env.IS_RELEASE == 'true' && ' and push' || '' }} ${{ inputs.app }}
        id: build
        uses: docker/build-push-action@v7
        with:
          context: ${{ inputs.context }}
          file: ${{ inputs.dockerfile }}
          push: ${{ env.IS_RELEASE == 'true' }}
          load: ${{ env.IS_RELEASE != 'true' }}
          provenance: false   # single image manifest, so the registry digest equals the running image digest
          sbom: false
          build-args: |
            VERSION=${{ needs.version.outputs.version }}
            COMMIT=${{ needs.version.outputs.commit }}
          tags: |
            ${{ env.REGISTRY }}/${{ inputs.image_repository }}:${{ needs.version.outputs.version }}
            ${{ env.REGISTRY }}/${{ inputs.image_repository }}:sha-${{ needs.version.outputs.commit }}
          cache-from: type=gha,scope=${{ inputs.app }}
          cache-to: type=gha,scope=${{ inputs.app }},mode=max
      - name: Record image
        run: |
          mkdir -p manifest
          printf '{"app":"%s","image":"%s","tag":"%s","digest":"%s"}\n' "${{ inputs.app }}" "${{ env.REGISTRY }}/${{ inputs.image_repository }}" "${{ needs.version.outputs.version }}" "${{ steps.build.outputs.digest }}" > "manifest/${{ inputs.app }}.json"
          echo "- \`${{ env.REGISTRY }}/${{ inputs.image_repository }}:${{ needs.version.outputs.version }}\` ${{ steps.build.outputs.digest }}" >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v7
        with:
          name: image-${{ inputs.app }}-${{ needs.version.outputs.version }}
          path: manifest/
          retention-days: 30

  release:
    name: release ${{ needs.version.outputs.version }}
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/<% github.default_branch %>'
    needs: [version, image]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@v7
        with:
          name: image-${{ inputs.app }}-${{ needs.version.outputs.version }}
          path: manifest
      - name: Assemble release manifest
        run: |
          python3 - <<'PY'
          import json,glob
          images=[json.load(open(f)) for f in sorted(glob.glob("manifest/*.json"))]
          m={"project":"<% project.name %>","app":"${{ inputs.app }}","version":"${{ needs.version.outputs.version }}","tag":"${{ inputs.tag_prefix }}${{ needs.version.outputs.version }}",
             "commit":"${{ github.sha }}","run_id":"${{ github.run_id }}","images":images}
          json.dump(m,open("release-manifest.json","w"),indent=2); print(json.dumps(m,indent=2))
          PY
      - uses: actions/upload-artifact@v7
        with:
          name: release-manifest-${{ inputs.app }}-${{ needs.version.outputs.version }}
          path: release-manifest.json
          retention-days: 90
<%#eq options.versioning "nbgv"%>      - uses: actions/setup-dotnet@v6
        with:
          dotnet-version: 8.0.x
      - name: Tag the release commit (${{ inputs.tag_prefix }}${{ needs.version.outputs.version }})
        run: |
          dotnet tool install -g nbgv >/dev/null
          git config user.name "github-actions[bot]"; git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          TAG="${{ inputs.tag_prefix }}${{ needs.version.outputs.version }}"
          if git ls-remote --exit-code --tags origin "$TAG" >/dev/null 2>&1; then
            echo "tag $TAG already exists; nothing to do"
          else
            nbgv tag -p "${{ inputs.app_path }}"   # tag name comes from release.tagName in the app's version.json
            git push origin "$TAG"
          fi
<%/eq%><%#eq options.versioning "semantic-release"%>      - uses: actions/setup-node@v7
        with:
          node-version: 22
      - name: Publish the release (tag, notes, changelog)
        if: needs.version.outputs.version != '' && !startsWith(needs.version.outputs.version, '0.0.0-sha.')
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: npm ci --no-audit --no-fund && npx semantic-release
<%/eq%>      - name: Summary
        run: |
          echo "## Release <% project.name %>/${{ inputs.app }} ${{ needs.version.outputs.version }}" >> "$GITHUB_STEP_SUMMARY"
<%#if derived.pipelines.auto_cd%>          echo "<% derived.pipelines.name_prefix %>-${{ inputs.app }}-cd starts automatically for <% github.cd_environment %> and waits for the environment approval. Other environments: \`/slipway:deploy ${{ inputs.app }} ${{ needs.version.outputs.version }} <env>\`" >> "$GITHUB_STEP_SUMMARY"
<%else%>          echo "Deploy with: \`/slipway:deploy ${{ inputs.app }} ${{ needs.version.outputs.version }} <% github.cd_environment %>\`" >> "$GITHUB_STEP_SUMMARY"<%/if%>
