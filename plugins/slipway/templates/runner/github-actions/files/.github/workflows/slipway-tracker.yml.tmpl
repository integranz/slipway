<%#if derived.tracker_rest%># Generated by slipway (tracker=jira, tracker_transport=<% options.tracker_transport %>). Regenerate with the scaffold; do not hand-edit.
# Keeps the Jira story current without a session: when the onboarding pull request merges, the delivery story is found
# or created and its `Bootstrap` and `Dockerize` subtasks are closed. Deploy subtasks are kept current by _cd.yml.
# Needs the organisation (or repository) secret JIRA_API_TOKEN and variable JIRA_EMAIL; without them the steps print a
# notice and succeed (tracking never blocks delivery). The plugin's jira-rest.cjs is checked out at the rendering version.
name: slipway-tracker

on:
  pull_request:
    types: [closed]
    branches: [<% github.default_branch %>]

permissions:
  contents: read
  pull-requests: read

jobs:
  onboarding-merged:
    name: close Bootstrap and Dockerize subtasks
    if: github.event.pull_request.merged == true && (startsWith(github.event.pull_request.head.ref, 'slipway/') || startsWith(github.event.pull_request.head.ref, 'cursor/'))
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/checkout@v7
        with:
          repository: <% derived.marketplace.repo %>
          ref: v<% derived.plugin_version %>
          path: .slipway-plugin
      - name: Story and subtasks (Jira REST)
        env:
          JIRA_EMAIL: ${{ vars.JIRA_EMAIL }}
          JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
          PR_URL: ${{ github.event.pull_request.html_url }}
          MERGED_BY: ${{ github.event.pull_request.merged_by.login }}
        run: |
          set -euo pipefail
          J="node .slipway-plugin/plugins/slipway/scripts/jira-rest.cjs --repo . --soft"
          # One story for the whole run: resolve its key once and pass it to every call, so closing the first subtask
          # never makes the next call create a second story (the lookup by title ignores closed stories).
          KEY="$($J story ensure --title "<% derived.tracking.story_title %>" --json | jq -r '.key // empty')"
          [ -n "$KEY" ] || { echo "tracking: no story key (tracker unconfigured or unreachable); nothing to update"; exit 0; }
          S="$J --story $KEY"
          $S subtask done "Bootstrap <% project.name %>" --no-autoclose --message "Onboarding pull request merged by $MERGED_BY: $PR_URL"
<%#each derived.apps%>          $S subtask done "Dockerize <% name %>" --no-autoclose --message "Dockerfile and pipelines of <% name %> merged in $PR_URL"
<%/each%>          $S story autoclose
<%/if%>
