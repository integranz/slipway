# Local run of every app image exactly as built for the cloud (generated by slipway; regenerate, do not edit).
#   VERSION=$(nbgv get-version -v SemVer2 2>/dev/null || echo 0.0.0-local) docker compose up --build
# Host ports are offset so several apps on the same container port can coexist.
services:
<%#each derived.apps%>  <% name %>:
    build:
      context: <% build.context %>
      dockerfile: <% build.dockerfile_from_context %>
      args:
        VERSION: ${VERSION:-0.0.0-local}
    image: <% image_local %>:${VERSION:-0.0.0-local}
<%#if port%>    ports:
      - "<% local_port %>:<% port %>"
<%/if%><%#if upstream_list%>    depends_on:
<%#each upstream_list%>      - <% name %>
<%/each%><%/if%><%#eq stack "react-vite"%>    volumes:
      - ./<% path %>/nginx.local.conf:/etc/nginx/conf.d/default.conf:ro
<%/eq%><%/each%>
